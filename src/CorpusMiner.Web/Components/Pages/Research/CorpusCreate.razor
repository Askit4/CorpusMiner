@page "/research/{ResearchId:int}/corpus/new"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CorpusMiner.Web.Data

@attribute [Authorize]

@inject ApplicationDbContext Db
@inject NavigationManager NavigationManager

<PageTitle>Nuevo corpus</PageTitle>

@if (research is null)
{
    <p>Investigacion no encontrada.</p>
}
else
{
    <h1>Nuevo corpus en "@research.Title"</h1>

    <EditForm Model="Input" OnValidSubmit="CreateAsync" FormName="create-corpus">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />
        <div class="form-floating mb-3">
            <InputText @bind-Value="Input.Title" id="Input.Title" class="form-control" />
            <label for="Input.Title">Titulo</label>
        </div>
        <div class="form-floating mb-3">
            <InputTextArea @bind-Value="Input.Description" id="Input.Description" class="form-control"
                           style="height: 8rem" />
            <label for="Input.Description">Descripcion</label>
        </div>
        <button type="submit" class="btn btn-primary">Crear</button>
    </EditForm>
}

@code {
    [Parameter]
    public int ResearchId { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private MiningResearch? research;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        research = await Db.MiningResearches.FirstOrDefaultAsync(r => r.Id == ResearchId);
    }

    private async Task CreateAsync()
    {
        var corpus = new Corpus
        {
            MiningResearchId = ResearchId,
            Title = Input.Title,
            Description = Input.Description,
        };

        Db.Corpora.Add(corpus);
        await Db.SaveChangesAsync();

        NavigationManager.NavigateTo($"corpus/{corpus.Id}");
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(200)]
        public string Title { get; set; } = "";

        [StringLength(4000)]
        public string? Description { get; set; }
    }
}
