@page "/forum/new"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using CorpusMiner.Web.Data

@attribute [Authorize(Roles = Roles.Publishers)]

@inject ApplicationDbContext Db
@inject NavigationManager NavigationManager

<PageTitle>Publicar dataset</PageTitle>

<h1>Publicar dataset</h1>

<EditForm Model="Input" OnValidSubmit="PublishAsync" FormName="publish-dataset">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />
    <div class="form-floating mb-3">
        <InputText @bind-Value="Input.Title" id="Input.Title" class="form-control" />
        <label for="Input.Title">Titulo</label>
    </div>
    <div class="form-floating mb-3">
        <InputTextArea @bind-Value="Input.Description" id="Input.Description" class="form-control"
                       style="height: 8rem" />
        <label for="Input.Description">Descripcion</label>
    </div>
    <button type="submit" class="btn btn-primary">Publicar</button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task PublishAsync()
    {
        var userId = (await AuthState!).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? throw new InvalidOperationException("Usuario no autenticado.");

        var dataset = new Dataset
        {
            Title = Input.Title,
            Description = Input.Description,
            CreatedByUserId = userId,
        };

        Db.Datasets.Add(dataset);
        await Db.SaveChangesAsync();

        NavigationManager.NavigateTo($"forum/{dataset.Id}");
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(200)]
        public string Title { get; set; } = "";

        [StringLength(4000)]
        public string? Description { get; set; }
    }
}
